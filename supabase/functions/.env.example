# Copy to `.env` (gitignored) for LOCAL development only.
# Usage: supabase functions serve --env-file supabase/functions/.env
#
# For the hosted project set these with:
#   supabase secrets set OPENAI_API_KEY=sk-...
#   supabase secrets set OPENAI_MODEL=gpt-5.6-luna
#   supabase secrets set OPENAI_MAX_OUTPUT_TOKENS=500
#   supabase secrets set OPENAI_REASONING_EFFORT=low
#   supabase secrets set REVENUECAT_WEBHOOK_SECRET=...
# NEVER commit real values. NEVER put these in the iOS app.

# OpenAI — server-side only.
OPENAI_API_KEY=sk-REPLACE_ME
# Model is configurable without a code change.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_OUTPUT_TOKENS=500
OPENAI_REASONING_EFFORT=low

# Shared secret checked on the RevenueCat webhook (Authorization header).
REVENUECAT_WEBHOOK_SECRET=local-dev-webhook-secret
# RevenueCat secret server API key (never the public iOS SDK key).
REVENUECAT_API_KEY=sk_REPLACE_ME
REVENUECAT_APP_ID=app_REPLACE_ME
REVENUECAT_ENTITLEMENT_ID=plus
# Exact comma-separated App Store product identifiers configured in
# RevenueCat (monthly and yearly). Do not use documentation/example IDs.
REVENUECAT_PRODUCT_IDS=REPLACE_WITH_MONTHLY_ID,REPLACE_WITH_YEARLY_ID
REVENUECAT_EXPECTED_ENVIRONMENT=SANDBOX
REVENUECAT_EXPECTED_STORE=APP_STORE
# Optional; defaults to RevenueCat's production v1 API. Point this at a local
# fixture server for subscription-sync tests.
# REVENUECAT_API_BASE_URL=http://127.0.0.1:8787/v1

# Enables the x-debug-scenario header (error simulation + "canned" replies).
# NEVER set this on a hosted/production project.
DEV_ERROR_SIMULATION=true
